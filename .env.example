# Метаданные самого Airflow (не связаны с данными трёх репозиториев)
AIRFLOW_DB_PASSWORD=changeme
# Пароль веб-интерфейса Airflow (логин admin, http://localhost:8080)
AIRFLOW_ADMIN_PASSWORD=admin
# ОБЯЗАТЕЛЕН — без него docker compose откажется стартовать. С пустым ключом
# Airflow не шифрует Connections, и сохранённые подключения перестают
# читаться после пересоздания контейнера.
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Креды тех же баз, что уже используют etl-portfolio / product-marketing-analytics /
# support-triage-llm (см. их .env) — здесь нужны те же значения, DAG подключается
# к тем же базам, только с хоста host.docker.internal вместо localhost.
# Все три обязательны: раньше при незаполненном значении подстановка давала
# пустой пароль и падение приходило уже из середины пайплайна, а не со старта.
ETL_DB_PASSWORD=changeme
VECTOR_DB_PASSWORD=changeme
CLICKHOUSE_PASSWORD=changeme
